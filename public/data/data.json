  "faq": [
    {
      "keywords": [
        "deliver",
        "delivery",
        "logistics",
        "lead"
      ],
      "answer": "We dispatch across Kenya and can coordinate East Africa deliveries. Typical lead times depend on product and plant load — share your site location in a quote request for a concrete timeline."
    },
    {
      "keywords": [
        "kebs",
        "cert",
        "standard"
      ],
      "answer": "Our catalogue products are manufactured with KEBS-aligned quality processes. Project documentation can be provided with your order for records."
    },
    {
      "keywords": [
        "pipe",
        "drain",
        "hydraulic"
      ],
      "answer": "Drainage quantities depend on run length, joint type, and fall. Use the drainage calculator for sections, then our engineers can validate networks on site."
    },
    {
      "keywords": [
        "pav",
        "block",
        "driveway"
      ],
      "answer": "Paving estimates use m² × blocks per m² plus a wastage buffer for cuts. Patterns and edge restraints may add margin — the calculator is a solid first pass."
    },
    {
      "keywords": [
        "roof",
        "tile",
        "ridge"
      ],
      "answer": "Roof tile counts exclude ridge and special pieces by default. Add a note in your quote if you need ridges, starters, or accessories."
    },
    {
      "keywords": [
        "pay",
        "price",
        "cost"
      ],
      "answer": "Indicative pricing is confirmed per project. Use “Request quote” with your calculator + cart — we respond with formal pricing."
    },
    {
      "keywords": [
        "hours",
        "open",
        "contact"
      ],
      "answer": "See contact details on this page for hours and channels. WhatsApp is fastest for quick questions."
